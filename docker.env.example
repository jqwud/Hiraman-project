# Settings for docker compose. Copy this file to docker.env (never commit docker.env) and change every value.

# MySQL: the administrator password, and the password of the "hiraman" account the API uses.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# Login tokens are signed with this. Use a long random string (for example: openssl rand -hex 32).
# The server refuses to start in production while it is still this example value.
JWT_SECRET=change-this-to-a-long-random-string

# Other web addresses allowed to call the API (comma-separated). Empty: this server's own pages only.
CORS_ORIGIN=

# Shown to residents for items the barangay handles (optional).
HALL_PHONE=

# The barangay's Data Protection Officer, shown in the privacy notice.
DPO_NAME=
DPO_EMAIL=
DPO_PHONE=
