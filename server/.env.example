# Copy to .env and edit
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hiraman
# Required in production: a long random string (16+ characters)
JWT_SECRET=change-this-to-a-long-random-string
# Other web addresses allowed to call the API, comma-separated (* = any). Empty = this server and localhost.
CORS_ORIGIN=
# Phone number of the barangay hall, shown for items the barangay handles (optional)
HALL_PHONE=
# The barangay's Data Protection Officer, shown in the privacy notice (RA 10173)
DPO_NAME=
DPO_EMAIL=
DPO_PHONE=
