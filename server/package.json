{
  "name": "hiraman-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hiraman API: shared backend for the resident mobile app and the LGU web portal",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node seed.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:down": "node scripts/migrate.js down",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test test/rules.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6"
  }
}
